# Copy to .env and adjust. All variables are optional.
# SQLite file (dev default). For Postgres:
# DATABASE_URL=postgresql+psycopg2://dualfolio:secret@localhost:5432/dualfolio
DATABASE_URL=
# Portfolio base currency: HKD | USD | CNY
BASE_CURRENCY=HKD
# Comma-separated CORS origins, or * for dev
CORS_ORIGINS=*
# yfinance HTTP timeout in seconds
YFINANCE_TIMEOUT=15
# Market data provider: eastmoney (default, unofficial push2 API) or yfinance.
# The other one is always the automatic per-symbol fallback.
MARKET_PROVIDER=eastmoney
# Optional HTTP Basic auth for /api/* (except /api/health). Leave unset for local dev.
# BASIC_AUTH_USER=
# BASIC_AUTH_PASS=
