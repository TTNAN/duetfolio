FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
# exact, tested versions (see backend/requirements.lock)
COPY backend/requirements.lock .
RUN pip install --no-cache-dir -r requirements.lock

COPY backend/ ./

# the server runs as an unprivileged user; /data holds the SQLite file.
# entrypoint.sh fixes ownership of pre-existing (root-owned) volumes and
# then drops privileges before starting uvicorn.
RUN useradd --system --uid 10001 --no-create-home duetfolio \
    && mkdir -p /data \
    && chown -R duetfolio:duetfolio /data /app
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

# CORS_ORIGINS is empty by default: the bundled nginx serves the UI and
# proxies /api on the same origin, so no cross-origin access is needed.
# Set e.g. CORS_ORIGINS=https://my.domain to allow a separate frontend.
ENV DATABASE_URL=sqlite:////data/duetfolio.db \
    BASE_CURRENCY=HKD \
    CORS_ORIGINS=

VOLUME ["/data"]
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=4).status == 200 else 1)"

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
