# Build stage
FROM node:20-alpine AS build
WORKDIR /app
# package-lock.json must be copied too: `npm ci` refuses to run without it
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
# Empty = same-origin relative /api requests, proxied by nginx below.
# Only set this when the API lives on a different host.
ARG VITE_API_URL=
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

# Serve stage
FROM nginx:alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
